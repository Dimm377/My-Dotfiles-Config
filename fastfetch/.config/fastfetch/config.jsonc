{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "arch",
        "padding": {
            "top": 1,
            "right": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[37m", "\u001b[38;5;16m", "\u001b[38;5;17m", "\u001b[38;5;18m"]
    },
    "modules": [
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "command",
            "key": "│   uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{>22} │"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$4}󰻀{$1}  distro",
            "text": "printf 'Arch Linux (btw)'",
            "format": "{$4}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  wm    ",
            "text": "printf 'Hyprland'",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  shell ",
            "text": "printf 'fish'",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$3}{$1}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$3}{>22}{$1} │"
        },
        {
            "type": "packages",
            "key": "│   pkgs  ",
            "format": "{all>22} │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}
